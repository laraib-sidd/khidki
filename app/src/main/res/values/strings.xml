    <!-- Welcome -->
    <string name="welcome_title">Welcome to Khidki</string>
    <string name="welcome_step1_title">OTP forwarding, on your phone</string>
    <string name="welcome_step1_body">Khidki forwards matching OTP SMS to a trusted number — only during a window you control. Nothing leaves your device except SMS you choose to forward.</string>
    <string name="welcome_step2_title">SMS only — not chat</string>
    <string name="welcome_step2_body">Khidki reads SMS, not RCS or in-app chat. Bank and delivery OTPs that arrive as SMS work. Messages in Google Messages RCS chats do not.</string>
    <string name="welcome_step3_title">Quick setup</string>
    <string name="welcome_step3_body">Android may require extra steps before SMS access works. We will guide you through permissions next.</string>
    <string name="welcome_continue">Continue</string>
    <string name="welcome_get_started">Get started</string>

