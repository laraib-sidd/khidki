<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Khidki" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:colorPrimary">@color/khidki_primary</item>
    </style>

    <style name="Theme.Khidki.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/khidki_primary</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Khidki</item>
    </style>
</resources>
